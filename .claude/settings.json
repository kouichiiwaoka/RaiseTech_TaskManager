{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "EnterWorktree",
      "ExitWorktree",
      "mcp__codex",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --force:*)",
      "Bash(git checkout -f:*)",
      "Bash(git checkout --:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --force:*)",
      "Bash(git restore --worktree:*)",
      "Bash(git restore .:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git gc:*)",
      "Bash(git prune:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git reflog expire:*)",
      "Bash(git reflog delete:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git worktree:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(unlink:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/crash.log)",
      "Edit(~/.aws/**)",
      "Write(~/.aws/**)",
      "Edit(./.git/**)",
      "Write(./.git/**)"
    ],
    "ask": [
      "Bash(git push --delete:*)",
      "Bash(git push -d:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push origin -d:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\" || { echo '[guard_bash] フックを実行できないため Bash を停止しました（python3 を確認）' >&2; exit 2; }",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
