# Additional restrictions for RaiseTech_TaskManager. Requires trusted project config.
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "reset", "--hard"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "checkout", "--force"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "checkout", "-f"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "checkout", "--"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "switch", "--discard-changes"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "switch", "-f"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "restore", "--worktree"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "restore", "."], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "clean"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "rebase"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "commit", "--amend"], decision = "forbidden", justification = "Project prohibits discarding work or rewriting history.")
prefix_rule(pattern = [["rm", "/bin/rm", "/usr/bin/rm"]], decision = "forbidden", justification = "Project prohibits file deletion.")
prefix_rule(pattern = [["rmdir", "/bin/rmdir", "/usr/bin/rmdir"]], decision = "forbidden", justification = "Project prohibits file deletion.")
prefix_rule(pattern = [["unlink", "/bin/unlink", "/usr/bin/unlink"]], decision = "forbidden", justification = "Project prohibits file deletion.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "gc"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "prune"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "filter-branch"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "filter-repo"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "reflog", "expire"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "reflog", "delete"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "branch", "-D"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "stash", "drop"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "stash", "clear"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "push", "--force"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "push", "-f"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "push", "--force-with-lease"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "push", "--mirror"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "push", "--delete"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
prefix_rule(pattern = [["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "push", "-d"], decision = "forbidden", justification = "User authorized routine Git workflow; prohibit loss of work and recovery information.")
